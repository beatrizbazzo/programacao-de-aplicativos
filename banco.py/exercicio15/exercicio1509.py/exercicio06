import sqlite3
def busca_binaria(vetor, numero):
    inicio = 0
    fim = len(vetor) - 1

    while inicio <= fim:
        meio = (inicio + fim) // 2

        if vetor[meio] == numero:
            return meio

        if numero > vetor[meio]:
            inicio = meio + 1
        else:
            fim = meio - 1

    return -1


vetor = [10, 20, 30, 40, 50, 60, 70, 80, 90]

numero = int(input("Digite um número: "))

posicao = busca_binaria(vetor, numero)

if posicao != -1:
    print("Número encontrado no índice:", posicao)
else:
    print("Número não encontrado.")