import sqlite3
def contar_valor(lista, valor):
    contador = 0

    for numero in lista:
        if numero == valor:
            contador += 1

    return contador


lista = [2, 5, 2, 8, 2, 10, 5]

valor = int(input("Digite um valor: "))

quantidade = contar_valor(lista, valor)

print("O valor aparece", quantidade, "vezes.")
