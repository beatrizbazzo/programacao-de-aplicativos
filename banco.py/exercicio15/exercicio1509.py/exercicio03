import sqlite3
def maior_numero(vetor):
    maior = vetor[0]
    posicao = 0

    for i in range(1, len(vetor)):
        if vetor[i] > maior:
            maior = vetor[i]
            posicao = i

    return maior, posicao


vetor = [15, 8, 32, 10, 25, 40, 7]

maior, posicao = maior_numero(vetor)

print("Maior número:", maior)
print("Posição:", posicao)