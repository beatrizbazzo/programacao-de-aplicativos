import sqlite3
def busca_binaria(vetor, numero):
    inicio = 0
    fim = len(vetor) - 1
    comparacoes = 0

    while inicio <= fim:
        meio = (inicio + fim) // 2

        comparacoes += 1

        if vetor[meio] == numero:
            return meio, comparacoes

        if numero > vetor[meio]:
            inicio = meio + 1
        else:
            fim = meio - 1

    return -1, comparacoes


vetor = [10, 20, 30, 40, 50, 60, 70, 80, 90]

numero = int(input("Digite um número: "))

posicao, comparacoes = busca_binaria(vetor, numero)

print("Posição:", posicao)
print("Comparações realizadas:", comparacoes)